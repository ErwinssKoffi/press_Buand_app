# ECLAT_DATABASE_URL : obligatoire (postgres://user:pass@host:5432/db)
ECLAT_DATABASE_URL="postgres://eclat:CHANGE_ME@localhost:5432/eclat"

# ECLAT_ENV : development | production | test (production force cookie Secure + refuse les PIN faibles)
ECLAT_ENV="development"

# ECLAT_HTTP_ADDR : adresse d'écoute HTTP
ECLAT_HTTP_ADDR=":8080"

# ECLAT_BASE_URL : URL publique (optionnel)
ECLAT_BASE_URL=""

# ECLAT_STORAGE_DIR : dossier privé des photos de réserves
ECLAT_STORAGE_DIR="/var/lib/eclat/storage"

# ECLAT_SESSION_TTL : durée de session (ex. 168h = 7 jours)
ECLAT_SESSION_TTL="168h"

# ECLAT_CORS_ORIGINS : origines autorisées séparées par des virgules (vide = CORS fermé)
ECLAT_CORS_ORIGINS=""

# ECLAT_BODY_LIMIT : limite de taille du corps (octets)
ECLAT_BODY_LIMIT="10485760"

# ECLAT_LOGIN_MAX_ATTEMPTS : échecs de login avant lockout persistant
ECLAT_LOGIN_MAX_ATTEMPTS="5"

# ECLAT_LOGIN_LOCKOUT : durée du lockout
ECLAT_LOGIN_LOCKOUT="5m"

# ECLAT_AUTO_MIGRATE : appliquer les migrations au démarrage
ECLAT_AUTO_MIGRATE="true"

# ECLAT_MIGRATIONS_DIR : dossier des migrations SQL (dans le conteneur : /app/migrations)
ECLAT_MIGRATIONS_DIR=""

# ECLAT_SHUTDOWN_GRACE : délai d'arrêt gracieux
ECLAT_SHUTDOWN_GRACE="15s"
